# =============================================================================
# Maps of Making — the app's web server (container maps-web)
#
# Serves web/ and routes to the app's backends. Plain HTTP on :80: TLS,
# hostnames and the server's front door are the host's gateway, which sends
# every Maps of Making host here unchanged. Everything the app decides lives
# in this file: which host shows which section, paths, headers.
#
# Hosts are matched on their first label, so the same file serves
# mapsofmaking.org, the .com, a test subdomain and localhost:
#   genjson.*      → the forwarder at /, a 301 to home elsewhere (14.8)
#   mothersand.*  → /mothersand/
#   anything else  → the map
# =============================================================================

{
	# No admin API, no certificates: this server sits behind the gateway.
	admin off
	auto_https off
	servers {
		# The gateway is on a private Docker network: trust its
		# X-Forwarded-For, so logs and link-handler see the visitor's address.
		trusted_proxies static private_ranges
	}
}

:80 {
	# Access log on stdout (docker logs maps-web).
	log

	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@genjson_host expression {host}.startsWith("genjson.")
	@mothersand_host expression {host}.startsWith("mothersand.")

	# ── Host → section ───────────────────────────────────────────────────────
	# A section host shows its folder at its root. Top-level `rewrite` runs
	# before every `handle` below (Caddy's directive order), so the path
	# routes (the backends) apply to the rewritten path.
	# Not inside a `route` block: `route` sorts after `handle` and would
	# never run.
	rewrite @mothersand_host /mothersand{uri}
	# genjson is retired (Story 14.8): home.mapsofmaking.org replaced it. Only
	# `/` still serves a page, one that forwards a draft kept in this browser to
	# home (web/genjson/index.html); every other path is a 301 to home, the
	# query kept. `redir` runs before `rewrite`, on the address as it came.
	@genjson_query expression `{host}.startsWith("genjson.") && {path} != "/" && {query} != ""`
	redir @genjson_query https://home.mapsofmaking.org/?{query} 301
	@genjson_other expression `{host}.startsWith("genjson.") && {path} != "/"`
	redir @genjson_other https://home.mapsofmaking.org/ 301
	@genjson_page {
		expression {host}.startsWith("genjson.")
		path /
	}
	rewrite @genjson_page /genjson{uri}

	# ── Headers per section ─────────────────────────────────────────────────
	# The map is embedded in other sites (iframe): allow any parent.
	header @genjson_host {
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "default-src 'self' 'unsafe-inline'"
	}
	header @mothersand_host {
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval'"
	}
	@map_host not expression {host}.startsWith("genjson.") || {host}.startsWith("mothersand.")
	header @map_host Content-Security-Policy "frame-ancestors *"

	# ── Health check (compose healthcheck) ─────────────────────────────────
	handle /health {
		log_skip
		respond "ok" 200
	}

	# ── SPARQL (Oxigraph) ────────────────────────────────────────────────────
	# Read: public, any origin (open data; ADR-018: this URL is a contract).
	handle /sparql/query {
		header Access-Control-Allow-Origin "*"
		rewrite * /query?{query}
		reverse_proxy oxigraph:7878 {
			transport http {
				dial_timeout 10s
				response_header_timeout 30s
			}
		}
	}
	# Update: never from outside. CORS preflight answered, everything else 403.
	handle /sparql/update {
		@preflight method OPTIONS
		handle @preflight {
			header {
				Access-Control-Allow-Origin "*"
				Access-Control-Allow-Methods "GET, POST, OPTIONS"
				Access-Control-Max-Age "86400"
			}
			respond 204
		}
		respond 403
	}

	# ── link-handler (FastAPI) ───────────────────────────────────────────────
	# Timeouts per endpoint: /raw and /snapshots answer fast or not at all;
	# the rest of /api/ includes /api/heartbeat-space/{id} and
	# /api/rematerialize, which run a whole-corpus query.
	@snapshots path_regexp ^/api/space/[^/]+/snapshots$
	handle @snapshots {
		reverse_proxy mak-link-handler:8000 {
			transport http {
				response_header_timeout 10s
			}
		}
	}
	@raw path_regexp ^/api/space/[^/]+/raw$
	handle @raw {
		reverse_proxy mak-link-handler:8000 {
			transport http {
				response_header_timeout 15s
			}
		}
	}
	handle /api/* {
		reverse_proxy mak-link-handler:8000 {
			transport http {
				response_header_timeout 60s
			}
		}
	}
	handle /claim/* {
		reverse_proxy mak-link-handler:8000
	}

	# ── The vocabulary (ontology/, a subtree of mapsofmaking_ontology) ─────
	# Its IRIs live here (https://mapsofmaking.org/ns/mom#Space, …), so they
	# resolve: /ns/mom, /ns/core, /ns/iop, /ns/sup, /ns/crosswalks/mom-to-okw
	# answer the Turtle file; /ns/<file>.ttl too. Readable from anywhere.
	handle_path /ns/* {
		root * /ns
		rewrite /iop /iop/iop.ttl
		@term path /mom /core /sup /crosswalks/mom-to-okw
		rewrite @term {path}.ttl
		header Access-Control-Allow-Origin "*"
		header Cache-Control "no-cache"
		@turtle path *.ttl
		header @turtle Content-Type "text/turtle; charset=utf-8"
		file_server
	}

	# ── Static files: the map, genjson, mothersand, data ──────────────────
	# Revalidate on every load (ETag → cheap 304), so a deployed fix or a new
	# spaces.geojson reaches returning visitors without a hard refresh.
	handle {
		header Cache-Control "no-cache"
		file_server {
			index maps-of-making.html index.html
		}
	}
}
